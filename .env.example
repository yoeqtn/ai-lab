# 复制为 .env 后填入真实值：cp .env.example .env

# ---- LLM / Embedding（阿里云百炼）----
LLM_MODEL=qwen-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-key
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024
EMBED_BATCH=10

# ---- PostgreSQL（不要带 +asyncpg，代码会自动转换）----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_lab

# ---- LangSmith 追踪（可选）----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=lc-course

# ---- 其他（当前代码未直接使用，保留）----
JWT_SECRET_KEY=change-me
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
TAVILY_API_KEY=
OSS_ACCESSKEY_KEY_ID=
OSS_ACCESSKEY_KEY_SECRET=
OSS_BUCKET=
DAILY_QUOTA=50
REJECT_DISTANCE=0.55
