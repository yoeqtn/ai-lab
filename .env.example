# 复制为 .env 后填入真实值：cp .env.example .env

# ---- LLM / Embedding（阿里云百炼）----
LLM_MODEL=qwen-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 注意：向量维度必须与数据库 chunks.embedding 的维度一致（默认 1024）
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024
EMBED_BATCH=10
# 批量向量化的并发数（受服务端限流影响，建议 2-5）
EMBED_CONCURRENCY=3
LLM_TIMEOUT=60

# ---- PostgreSQL（不要带 +asyncpg，代码会自动转换）----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_lab
# 是否打印 SQL（排查问题时临时设为 true）
SQL_ECHO=false

# ---- 业务参数 ----
# 检索结果余弦距离上限（1 - 余弦相似度），越小越严格
REJECT_DISTANCE=0.55
# 单条聊天消息最大字符数 / 单文件解析后的最大字符数
MAX_INPUT_CHARS=4000
MAX_UPLOAD_CHARS=200000

# ---- 接口鉴权 ----
# 设置后，/admin/* 与 /upload 需要携带 X-API-Key 请求头；留空 = 本地开发不校验
APP_API_TOKEN=

# ---- LangSmith 追踪（可选）----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=lc-course

# ---- 预留（当前代码未直接使用）----
JWT_SECRET_KEY=change-me
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
TAVILY_API_KEY=
OSS_ACCESSKEY_KEY_ID=
OSS_ACCESSKEY_KEY_SECRET=
OSS_BUCKET=
DAILY_QUOTA=50
